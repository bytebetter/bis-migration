{
  "name": "bis-pacs-sync-manager",
  "description": "Please enter a description for your extension",
  "icon": "extension",
  "version": "1.0.14",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-operation"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "source": {
      "app": "src/app.ts",
      "api": "src/api.ts"
    },
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "build:dev": "directus-extension build",
    "build:stg": "directus-extension build",
    "build:prod": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.4",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.25"
  }
}
