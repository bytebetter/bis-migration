{
  "name": "bis-pricing-bundle",
  "description": "Please enter a description for your extension",
  "icon": "extension",
  "version": "1.0.3",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "pricing-endpoint",
        "source": "src/pricing-endpoint/index.js"
      },
      {
        "type": "operation",
        "name": "pricing-operation",
        "source": {
          "app": "src/pricing-operation/app.js",
          "api": "src/pricing-operation/api.js"
        }
      }
    ],
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.4"
  }
}
