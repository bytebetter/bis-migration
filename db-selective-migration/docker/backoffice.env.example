# Copy to: db-selective-migration/.env.backoffice (see docs/local-stack-docker.md)

# Pre-built image (NEXT_PUBLIC_* ถูก bake ตอน build image — เปลี่ยน URL ต้อง build tag ใหม่)
BACKOFFICE_IMAGE=bytebetter/bis-backoffice:v1.0.0
BACKOFFICE_PORT=3000

# Directus CORS — ให้ backoffice เรียก API จาก browser ได้
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
