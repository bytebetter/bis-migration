# Copy to: db-selective-migration/.env.supabase (gitignored)
#
# Dashboard → Project Settings → Database → Connection string → URI
# Use Direct connection (port 5432 / db.<ref>.supabase.co).
# Do NOT use Transaction pooler (port 6543) with pg_dump.

SOURCE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase dev: Directus tables in bis_dev; prod Docker uses public
SOURCE_SCHEMA=bis_dev
TARGET_SCHEMA=public
