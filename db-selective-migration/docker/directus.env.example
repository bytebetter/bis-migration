# Copy to: db-selective-migration/.env.directus (see docs/directus-docker.md)
#
# ค่า DB_* ควรตรงกับ .env.postgres เมื่อรันร่วมกับ docker-compose.postgres.yml
# ถ้ารันคู่กับ --env-file .env.postgres ไม่ใส่ DB_PASSWORD ก็ได้ (ใช้ POSTGRES_PASSWORD แทน)

DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
# DB_DATABASE=bisinfo
# DB_USER=bis
# DB_PASSWORD=change-me

# สุ่มค่าใหม่ (เก็บให้คงที่ — ใช้ซ้ำทุกครั้งที่ restart)
#   openssl rand -hex 16
KEY=replace-with-random-hex
#   openssl rand -hex 32
SECRET=replace-with-longer-random-hex

# ใช้สร้าง admin ครั้งแรกเท่านั้น (ถ้า DB มี directus_users จาก restore แล้ว ให้ล็อกอินด้วย user เดิม)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

PUBLIC_URL=http://localhost:8055
DIRECTUS_PORT=8055

# Redis cache (service `redis` ใน docker-compose.yml)
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_AUTO_PURGE=true
REDIS=redis://redis:6379
