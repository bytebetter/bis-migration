# Copy to: db-selective-migration/.env.flows (gitignored)
# Used by scripts/db-flows-sync.sh — Directus flows + operations only.
#
# Primary workflow is two machines via git (no SSH):
#   A) Dev/CI machine with source DB → export → commit exports/directus-flows/ → push
#   B) Private prod server → git pull → compare/apply/restore with DEST_* only

# ── Machine A (export only) ───────────────────────────────────────────────
# Same pattern as docker/supabase.env.example.
# Prefer Direct connection (port 5432), not transaction pooler (:6543).
SOURCE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SOURCE_SCHEMA=bis_dev

# Schema written into the committed snapshot SQL (prod usually uses public).
EXPORT_SCHEMA=public

# ── Machine B (prod server — compare / apply / restore) ───────────────────
# Local Postgres on the box (Directus Docker stack binds 127.0.0.1).
# SOURCE_* is NOT required here.
DEST_DATABASE_URL=postgresql://bis:YOUR_PASSWORD@127.0.0.1:5432/bisinfo
DEST_SCHEMA=public

# Optional overrides:
# FLOWS_SNAPSHOT_DIR=exports/directus-flows
# CONTENT_ONLY=true
# PG_USE_DOCKER=true
# PG_CLIENT_IMAGE=postgres:17-alpine
# PG_DUMP_MIN_MAJOR=17
