# Copy to: db-selective-migration/.env.flows (gitignored)
# Used by scripts/db-flows-sync.sh — Directus flows + operations only.
#
# Source (dev / staging): same pattern as docker/supabase.env.example
# Prefer Direct connection (port 5432), not transaction pooler (:6543).

SOURCE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SOURCE_SCHEMA=bis_dev

# Destination (private production Postgres). Bound to localhost on the server
# is fine — either open an SSH tunnel yourself, or set DEST_SSH_* below.
DEST_DATABASE_URL=postgresql://bis:YOUR_PASSWORD@127.0.0.1:5432/bisinfo
DEST_SCHEMA=public

# Optional SSH local-forward into private prod (started/stopped by the script).
# When set, DEST_DATABASE_URL should point at 127.0.0.1:DEST_SSH_LOCAL_PORT.
# DEST_SSH_HOST=user@prod-server.example
# DEST_SSH_PORT=22
# DEST_SSH_LOCAL_PORT=15432
# DEST_SSH_REMOTE_HOST=127.0.0.1
# DEST_SSH_REMOTE_PORT=5432
# DEST_SSH_IDENTITY_FILE=~/.ssh/id_ed25519

# Optional: force Docker postgres:17 client (same as selective dump helpers)
# PG_USE_DOCKER=true
# PG_CLIENT_IMAGE=postgres:17-alpine
